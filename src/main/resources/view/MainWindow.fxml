<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="220.0" minWidth="300.0" prefHeight="600.0" prefWidth="400.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="randy.MainWindow">
    <children>
        <TextField fx:id="inputField" promptText="Type a command..." onAction="#handleSend" prefHeight="41.0" AnchorPane.bottomAnchor="1.0" AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="76.0"/>
        <Button fx:id="sendBtn" mnemonicParsing="false" onAction="#handleSend" prefHeight="41.0" prefWidth="76.0" text="Send" AnchorPane.bottomAnchor="1.0" AnchorPane.rightAnchor="1.0"/>
        <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" hvalue="1.0" vvalue="1.0" AnchorPane.topAnchor="1.0" AnchorPane.bottomAnchor="43.0" AnchorPane.leftAnchor="1.0" AnchorPane.rightAnchor="1.0" fitToWidth="true">
            <content>
                <VBox fx:id="chatBox" prefWidth="388.0" />
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
